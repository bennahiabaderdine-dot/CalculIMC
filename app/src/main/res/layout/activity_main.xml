<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/titre"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="30dp" />

    <EditText
        android:id="@+id/editTextPoids"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/poids"
        android:inputType="numberDecimal"
        android:layout_marginBottom="15dp" />

    <EditText
        android:id="@+id/editTextTaille"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/taille"
        android:inputType="numberDecimal"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/buttonCalculer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/calculer" />

    <Button
        android:id="@+id/buttonEffacer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/effacer"
        android:layout_marginTop="10dp" />

    <TextView
        android:id="@+id/textViewImc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/resultat"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="30dp" />

    <TextView
        android:id="@+id/textViewCategorie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/categorie"
        android:textSize="20sp"
        android:gravity="center"
        android:layout_marginTop="15dp" />

</LinearLayout>